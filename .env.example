# Copy to .env. Never commit .env. Use setup.ps1 to generate random passwords.
# POSTGRES_PASSWORD: use at least 32 random HEX characters (URL-safe).
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
# At least 12 characters. Only used when initializing the first administrator.
ADMIN_PASSWORD=
# false = empty production database; true = explicitly opted-in fictional demo dataset.
DEMO_MODE=false
COMPOSE_PROJECT_NAME=printtrack-local
HOST_BIND=127.0.0.1
APP_PORT=8080
# true requires HTTPS. For a local-only HTTP demonstration set false.
COOKIE_SECURE=true
